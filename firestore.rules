rules_version = '2';

// ===============================================================
// Firestore Security Rules: Contador de Horas OTS (120 Días)
// ===============================================================
//
// Assumed Data Model:
// -------------------
// Collection: lotes
// Document ID: {loteId} (UUID or string ID matching request.resource.data.id)
// Fields:
//   - id: string (required, 1-128 chars, immutable) - Unique lot identifier
//   - supermercado: string (required, 1-100 chars) - Retail chain / store name
//   - area: string (required, 1-100 chars) - Store department / section
//   - cantidadProductos: number (required, int >= 0 and <= 100000) - Product count
//   - ultimoInicio: string | null (optional, ISO 8601 date, 19-35 chars) - Last session start
//   - ultimoFin: string | null (optional, ISO 8601 date, 19-35 chars) - Last session end
//   - duracionMinutos: number (optional, >= 0 and <= 14400) - Duration of last session in minutes
//   - proximoDesbloqueo: string | null (optional, ISO 8601 date, 19-35 chars) - 120-day unlock timestamp
//   - activo: bool (required) - Logical active status (false = soft-deleted)
//   - notas: string (optional, 0-1000 chars) - Operator remarks or shelf instructions
//   - createdAt: string (required, ISO 8601 date, 19-35 chars, immutable) - Creation timestamp
//   - updatedAt: string (required, ISO 8601 date, 19-35 chars) - Modification timestamp
//
// Collection: registros_trabajo
// Document ID: {registroId} (Firestore auto-ID or client ID)
// Fields:
//   - id: string (required, 1-128 chars) - Historical record ID
//   - loteId: string | null (optional, 1-128 chars) - Reference to parent lote document
//   - supermercado: string (required, 1-100 chars) - Supermarket name
//   - area: string (required, 1-100 chars) - Department or section
//   - cantidadProductos: number (required, >= 0 and <= 100000) - Photographed product count
//   - fechaHoraInicio: string (required, ISO 8601 date, 19-35 chars) - Session start timestamp
//   - fechaHoraFin: string (required, ISO 8601 date, 19-35 chars) - Session finish timestamp
//   - duracionMinutos: number (required, >= 0 and <= 14400) - Duration in minutes
//   - horasDecimal: number (required, >= 0 and <= 240) - Duration in decimal hours
//   - duracionTexto: string (required, 1-50 chars) - Formatted human-readable duration (e.g., "1h 30m")
//   - desbloqueoCalculado: string (required, ISO 8601 date, 19-35 chars) - 120-day unlock timestamp
//   - observaciones: string (optional, 0-1000 chars) - Operator session observations
//   - createdAt: string (required, ISO 8601 date, 19-35 chars) - Creation timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-scoped paths)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner based on document's uid field
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Operator authorization for single-user field application:
    // Configured for field operator access without mandatory Firebase Auth initially,
    // and ready to be locked to authenticated operators when Auth credentials are configured.
    function isOperator() {
      return true;
      // To require Firebase Auth login in production, toggle to:
      // return isAuthenticated();
    }

    // Validate required fields exist in incoming data
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that immutable fields remain unchanged during update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validate ISO 8601 date string format (YYYY-MM-DDTHH:MM:SS...)
    function isValidIsoDate(dateStr) {
      return dateStr is string &&
        dateStr.size() >= 19 &&
        dateStr.size() <= 35 &&
        dateStr.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*");
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Validator for 'lotes' collection
    function isValidLote(data) {
      return hasOnlyAllowedFields([
               'id', 'supermercado', 'area', 'cantidadProductos',
               'ultimoInicio', 'ultimoFin', 'duracionMinutos',
               'proximoDesbloqueo', 'activo', 'notas',
               'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields([
               'id', 'supermercado', 'area', 'cantidadProductos',
               'activo', 'createdAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.supermercado is string && data.supermercado.size() >= 1 && data.supermercado.size() <= 100 &&
             data.area is string && data.area.size() >= 1 && data.area.size() <= 100 &&
             data.cantidadProductos is number && data.cantidadProductos >= 0 && data.cantidadProductos <= 100000 &&
             data.activo is bool &&
             isValidIsoDate(data.createdAt) &&
             isValidIsoDate(data.updatedAt) &&
             (!('duracionMinutos' in data) || (data.duracionMinutos is number && data.duracionMinutos >= 0 && data.duracionMinutos <= 14400)) &&
             (!('notas' in data) || (data.notas is string && data.notas.size() <= 1000)) &&
             (!('ultimoInicio' in data) || data.ultimoInicio == null || isValidIsoDate(data.ultimoInicio)) &&
             (!('ultimoFin' in data) || data.ultimoFin == null || isValidIsoDate(data.ultimoFin)) &&
             (!('proximoDesbloqueo' in data) || data.proximoDesbloqueo == null || isValidIsoDate(data.proximoDesbloqueo));
    }

    // Validator for 'registros_trabajo' collection
    function isValidRegistroTrabajo(data) {
      return hasOnlyAllowedFields([
               'id', 'loteId', 'supermercado', 'area', 'cantidadProductos',
               'fechaHoraInicio', 'fechaHoraFin', 'duracionMinutos',
               'horasDecimal', 'duracionTexto', 'desbloqueoCalculado',
               'observaciones', 'createdAt'
             ]) &&
             hasRequiredFields([
               'id', 'supermercado', 'area', 'cantidadProductos',
               'fechaHoraInicio', 'fechaHoraFin', 'duracionMinutos',
               'horasDecimal', 'duracionTexto', 'desbloqueoCalculado',
               'createdAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             (!('loteId' in data) || data.loteId == null || (data.loteId is string && data.loteId.size() >= 1 && data.loteId.size() <= 128)) &&
             data.supermercado is string && data.supermercado.size() >= 1 && data.supermercado.size() <= 100 &&
             data.area is string && data.area.size() >= 1 && data.area.size() <= 100 &&
             data.cantidadProductos is number && data.cantidadProductos >= 0 && data.cantidadProductos <= 100000 &&
             isValidIsoDate(data.fechaHoraInicio) &&
             isValidIsoDate(data.fechaHoraFin) &&
             data.duracionMinutos is number && data.duracionMinutos >= 0 && data.duracionMinutos <= 14400 &&
             data.horasDecimal is number && data.horasDecimal >= 0 && data.horasDecimal <= 240 &&
             data.duracionTexto is string && data.duracionTexto.size() >= 1 && data.duracionTexto.size() <= 50 &&
             isValidIsoDate(data.desbloqueoCalculado) &&
             (!('observaciones' in data) || (data.observaciones is string && data.observaciones.size() <= 1000)) &&
             isValidIsoDate(data.createdAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Collection: lotes
    match /lotes/{loteId} {
      // Allows field operator to read active/all lotes
      allow read: if isOperator();

      // Create: Validates full schema, ensures document ID matches data.id
      allow create: if isOperator() &&
                       isValidLote(request.resource.data) &&
                       request.resource.data.id == loteId;

      // Update: Validates full schema and guarantees immutability of ID and createdAt
      allow update: if isOperator() &&
                       isValidLote(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.createdAt == resource.data.createdAt;

      // Hard deletion is prohibited; soft delete is enforced via active: false in update
      allow delete: if false;
    }

    // Collection: registros_trabajo
    match /registros_trabajo/{registroId} {
      // Allows field operator to read session records and work history
      allow read: if isOperator();

      // Create: Validates all session fields and timestamps
      allow create: if isOperator() &&
                       isValidRegistroTrabajo(request.resource.data);

      // Historical records are strictly immutable and permanent
      allow update: if false;
      allow delete: if false;
    }
  }
}
