rules_version = '2';

// ===============================================================
// Firestore Security Rules: Contador de Horas OTS
// ===============================================================
//
// Assumed Data Model:
// -------------------
// Collection: lotes
// Document ID: {loteId}
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches document id)
//   - supermercado: string (required, 1-100 chars)
//   - area: string (required, 1-100 chars)
//   - cantidadProductos: int/number (required, >= 0 and <= 100000)
//   - ultimoInicio: string | null (optional, ISO 8601 date, 19-35 chars)
//   - proximoDesbloqueo: string | null (optional, ISO 8601 date, 19-35 chars)
//   - notas: string | null (optional, 0-1000 chars)
//   - creadoEn: string (required, ISO 8601 date, 19-35 chars, immutable)
//
// Collection: registros_trabajo
// Document ID: {registroId}
// Fields:
//   - id: string (required, 1-128 chars, immutable, matches document id)
//   - loteId: string (required, 1-128 chars)
//   - supermercado: string (required, 1-100 chars)
//   - area: string (required, 1-100 chars)
//   - cantidadProductos: int/number (required, >= 0 and <= 100000)
//   - inicio: string (required, ISO 8601 date, 19-35 chars)
//   - fin: string (required, ISO 8601 date, 19-35 chars)
//   - duracionMinutos: int/number (required, >= 0 and <= 14400)
//   - horasDecimales: number (required, >= 0 and <= 240)
//   - duracionTexto: string (required, 1-50 chars)
//   - nuevoDesbloqueo: string (required, ISO 8601 date, 19-35 chars)
//   - observaciones: string | null (optional, 0-1000 chars)
//   - creadoEn: string (required, ISO 8601 date, 19-35 chars, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Validate that required fields exist in the incoming data
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that only defined fields exist in the incoming document
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate ISO 8601 string format (e.g., 2026-11-06T04:20:24.000Z)
    function isValidIsoDate(dateStr) {
      return dateStr is string &&
        dateStr.size() >= 19 &&
        dateStr.size() <= 35 &&
        dateStr.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}.*");
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Schema and boundary validator for 'lotes'
    function isValidLote(data) {
      return hasOnlyAllowedFields([
               'id', 'supermercado', 'area', 'cantidadProductos',
               'ultimoInicio', 'proximoDesbloqueo', 'notas', 'creadoEn'
             ]) &&
             hasRequiredFields([
               'id', 'supermercado', 'area', 'cantidadProductos', 'creadoEn'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.supermercado is string && data.supermercado.size() >= 1 && data.supermercado.size() <= 100 &&
             data.area is string && data.area.size() >= 1 && data.area.size() <= 100 &&
             data.cantidadProductos is number && data.cantidadProductos >= 0 && data.cantidadProductos <= 100000 &&
             isValidIsoDate(data.creadoEn) &&
             (!('ultimoInicio' in data) || data.ultimoInicio == null || isValidIsoDate(data.ultimoInicio)) &&
             (!('proximoDesbloqueo' in data) || data.proximoDesbloqueo == null || isValidIsoDate(data.proximoDesbloqueo)) &&
             (!('notas' in data) || data.notas == null || (data.notas is string && data.notas.size() <= 1000));
    }

    // Schema and boundary validator for 'registros_trabajo'
    function isValidRegistroTrabajo(data) {
      return hasOnlyAllowedFields([
               'id', 'loteId', 'supermercado', 'area', 'cantidadProductos',
               'inicio', 'fin', 'duracionMinutos', 'horasDecimales',
               'duracionTexto', 'nuevoDesbloqueo', 'observaciones', 'creadoEn'
             ]) &&
             hasRequiredFields([
               'id', 'loteId', 'supermercado', 'area', 'cantidadProductos',
               'inicio', 'fin', 'duracionMinutos', 'horasDecimales',
               'duracionTexto', 'nuevoDesbloqueo', 'creadoEn'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.loteId is string && data.loteId.size() >= 1 && data.loteId.size() <= 128 &&
             data.supermercado is string && data.supermercado.size() >= 1 && data.supermercado.size() <= 100 &&
             data.area is string && data.area.size() >= 1 && data.area.size() <= 100 &&
             data.cantidadProductos is number && data.cantidadProductos >= 0 && data.cantidadProductos <= 100000 &&
             isValidIsoDate(data.inicio) &&
             isValidIsoDate(data.fin) &&
             data.duracionMinutos is number && data.duracionMinutos >= 0 && data.duracionMinutos <= 14400 &&
             data.horasDecimales is number && data.horasDecimales >= 0 && data.horasDecimales <= 240 &&
             data.duracionTexto is string && data.duracionTexto.size() >= 1 && data.duracionTexto.size() <= 50 &&
             isValidIsoDate(data.nuevoDesbloqueo) &&
             isValidIsoDate(data.creadoEn) &&
             (!('observaciones' in data) || data.observaciones == null || (data.observaciones is string && data.observaciones.size() <= 1000));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Collection: lotes
    match /lotes/{loteId} {
      allow read: if true;

      allow create: if isValidLote(request.resource.data) &&
                       request.resource.data.id == loteId;

      allow update: if isValidLote(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.id == loteId &&
                       request.resource.data.creadoEn == resource.data.creadoEn;

      allow delete: if true;
    }

    // Collection: registros_trabajo
    match /registros_trabajo/{registroId} {
      allow read: if true;

      allow create: if isValidRegistroTrabajo(request.resource.data) &&
                       request.resource.data.id == registroId;

      allow update: if isValidRegistroTrabajo(request.resource.data) &&
                       request.resource.data.id == resource.data.id &&
                       request.resource.data.id == registroId &&
                       request.resource.data.creadoEn == resource.data.creadoEn;

      allow delete: if true;
    }
  }
}
